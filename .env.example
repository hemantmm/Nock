# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://hooktrace:hooktrace@127.0.0.1:54329/hooktrace?schema=public"

# Encrypts signing secrets at rest. Use a long random string in production.
# Any string is accepted; a 32-byte base64 value is used as the raw AES key.
HOOKTRACE_ENCRYPTION_KEY="replace-with-a-long-random-string"

# Protects POST /api/cron/cleanup. Required for the HTTP cleanup route.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when this is set.
CRON_SECRET="replace-with-a-long-random-string"

# Default retention applied to new endpoints. Each endpoint can override it (1–30 days).
EVENT_RETENTION_DAYS="7"

# Replay refuses loopback, RFC1918, and link-local targets unless this is true.
# Leave false on any shared or public deployment. Link-local and cloud metadata
# addresses stay blocked even when this is true.
HOOKTRACE_ALLOW_PRIVATE_TARGETS="false"

# Ingestion caps. Values are requests per window.
HOOKTRACE_MAX_BODY_BYTES="1048576"
HOOKTRACE_INGEST_LIMIT="120"
HOOKTRACE_INGEST_IP_LIMIT="240"
HOOKTRACE_INGEST_WINDOW_MS="60000"
HOOKTRACE_CREATE_LIMIT="30"

# Optional. GitHub sign-in appears only when both are set.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_CALLBACK is the request origin plus /api/auth/github/callback.
